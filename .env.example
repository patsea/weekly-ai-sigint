# Weekly AI Sigint Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# REQUIRED - Anthropic Claude API
# ============================================
# Get your key at: https://console.anthropic.com/
# Used for AI-powered briefing synthesis
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ============================================
# OPTIONAL - Notion Export
# ============================================
# Create integration at: https://www.notion.so/my-integrations
# NOTION_TOKEN: Your integration secret (starts with "secret_")
# NOTION_PAGE_ID: 32-character ID from your Notion page URL
#
# To get page ID from URL:
#   https://notion.so/My-Page-abc123def456... → abc123def456...
#
# Remember to share the page with your integration!
NOTION_TOKEN=
NOTION_PAGE_ID=

# ============================================
# OPTIONAL - Slack Notifications
# ============================================
# Create webhook at: https://api.slack.com/messaging/webhooks
# Format: https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXX
SLACK_WEBHOOK_URL=

# ============================================
# SCHEDULER - Weekly Run Configuration
# ============================================
# When to automatically run the full pipeline (fetch + synthesize + export + notify)

# Day of week: mon, tue, wed, thu, fri, sat, sun
WEEKLY_RUN_DAY=sun

# Hour (0-23) - 6 = 6:00 AM
WEEKLY_RUN_HOUR=6

# Minute (0-59)
WEEKLY_RUN_MINUTE=0

# Timezone (IANA format)
# Examples: UTC, Europe/London, Europe/Madrid, America/New_York, America/Los_Angeles, Asia/Tokyo
# Full list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TIMEZONE=UTC

# ============================================
# DATABASE - SQLite Configuration
# ============================================
# Path to SQLite database file
# Default stores in ./data/weekly_sigint.db
DATABASE_URL=sqlite+aiosqlite:///data/weekly_sigint.db
